# Required — your Opencals Storefront API key
OPENCALS_API_KEY=sfk_your_key_here

# Optional — override API base URL (defaults to https://api.opencals.com)
# OPENCALS_API_URL=https://api.opencals.com

# The public site URL (sitemap, robots.txt, share images, structured data) is
# siteConfig.url in lib/site-config.ts — set it there, there is no env var for it.

# Optional — Stripe publishable key. Only a fallback: checkout uses the key the
# Opencals API returns for your store's Stripe connection when there is one.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...

# Required for auth — random secret for session encryption
AUTH_SECRET=change_me_to_a_random_string

# NOTE: Passwordless login codes and one-time email links (/link/[token]) work out
# of the box. For emailed links to point back to this app, set "Storefront Base URL"
# in your Opencals dashboard (Settings → API) to your deployed URL.
